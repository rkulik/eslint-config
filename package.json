{
  "name": "@rkulik/eslint-config",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "pnpm@10.24.0",
  "description": "René's ESLint configuration",
  "author": "René Kulik <rene@kulik.io> (https://www.kulik.io/)",
  "license": "MIT",
  "homepage": "https://github.com/rkulik/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkulik/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/rkulik/eslint-config/issues"
  },
  "keywords": [
    "eslint",
    "config",
    "eslint-config"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "eslint . -c eslint.config.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "prepare": "husky"
  },
  "peerDependencies": {
    "eslint": "10.8.0"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@typescript-eslint/utils": "8.65.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-destructuring": "2.2.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsonc": "3.3.0",
    "eslint-plugin-prefer-arrow-functions": "3.10.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "local-pkg": "1.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@jest/globals": "30.4.1",
    "@rkulik/prettier-config": "1.1.0",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  },
  "prettier": "@rkulik/prettier-config"
}
